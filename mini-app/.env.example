# Emberholm Mini App Environment Variables
# ==========================================
# IMPORTANT: Copy this file to .env.local for development
# For production, set these in your deployment platform (Vercel, etc.)

# Backend API URL (Flask server)
# - Development: http://localhost:5000
# - Production: https://emberholmportal.xyz
NEXT_PUBLIC_API_URL=http://localhost:5000

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
# Required for wallet connections outside of Farcaster
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Chain ID (8453 = Base Mainnet, 84532 = Base Sepolia for testing)
NEXT_PUBLIC_CHAIN_ID=8453
